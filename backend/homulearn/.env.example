# Copy to .env beside gradlew.bat. Use KEY=value without shell-style quotes.
# Spring Boot reads this as a Java properties file; use / in local file paths.
DB_URL=jdbc:postgresql://127.0.0.1:55432/homulearn_dev
DB_USER=homulearn
DB_PASSWORD=replace-with-your-local-password
PORT=8080
COOKIE_SECURE=false
